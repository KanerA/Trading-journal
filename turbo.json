{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "persistent": true,
            "cache": false,
            "dependsOn": [
                "@trading-journal/db-service#generate",
                "@trading-journal/types#build"
            ]
        },
        "build": {
            "dependsOn": [
                "@trading-journal/types#build",
                "@trading-journal/db-service#generate"
            ],
            "outputs": [
                "dist/**",
                "build/**"
            ]
        },
        "@trading-journal/db-service#generate": {
            "inputs": [
                "prisma/schema.prisma",
                "prisma/migrations/**",
                "$TURBO_ROOT$/apps/db-service/package.json"
            ],
            "env": [
                "DATABASE_URL"
            ],
            "outputs": [
                "node_modules/@prisma/client/**",
                "node_modules/.prisma/**"
            ]
        },
        "@trading-journal/types#build": {
            "outputs": [
                "src/**"
            ]
        }
    }
}