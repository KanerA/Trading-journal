{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "persistent": true,
            "cache": false,
            "dependsOn": [
                "@trading-journal/db-service#generate",
                "@trading-journal/types#build"
            ]
        },
        "build": {
            "dependsOn": [
                "@trading-journal/types#build",
                "@trading-journal/db-service#generate"
            ],
            "outputs": [
                "dist/**",
                "build/**"
            ]
        },
        "@trading-journal/db-service#generate": {
            "outputs": []
        },
        "@trading-journal/types#build": {
            "outputs": [
                "src/**"
            ]
        }
    }
}